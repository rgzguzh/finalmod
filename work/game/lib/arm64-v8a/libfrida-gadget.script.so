import{Game as t}from"../core/Game.js";import{Logger as e}from"../utils/Logger.js";export class Troll{static clientIdOf(r){try{const e=t.amongUsClient;if(!e)return-1;const o=e.field("allClients").value;for(const e of t.list(o)){const t=e.field("Character").value;if(t&&!t.isNull()&&t.handle.equals(r.handle))return e.field("Id").value}}catch(t){e.warn(`[Troll.clientIdOf] ${t}`)}return-1}static kickAsHost(r,o=!1){const l=this.clientIdOf(r);if(l<0)return!1;const s=t.amongUsClient;if(!s)return!1;try{const t=s.tryMethod("KickPlayer",2);return!!t&&(t.invoke(l,o),!0)}catch(t){return e.error(`[Troll.kickAsHost] ${t}`),!1}}static kickAsClient(r,o=3){const l=this.clientIdOf(r);if(l<0)return 0;let s=0;try{const e=t.cls("VoteBanSystem");if(!e)return 0;const r=e.field("Instance").value;if(!r||r.isNull())return 0;const c=r.tryMethod("CmdAddVote",1);if(!c)return 0;for(let t=0;t<o;t++)c.invoke(l),s++}catch(t){e.error(`[Troll.kickAsClient] ${t}`)}return s}static kick(e){return t.isHost()?{ok:this.kickAsHost(e),mode:"host"}:{ok:this.kickAsClient(e)>0,mode:"client(vote-ban)"}}static forceColor(r,o){let l=!1;try{r.method("SetColor",1).invoke(o),l=!0}catch(t){e.error(`[Troll.forceColor:SetColor] ${t}`)}let s=!1;if(t.isHost())try{r.method("RpcSetColor",1).invoke(o),s=!0}catch(t){}else try{r.method("RpcSetColor",1).invoke(o)}catch(t){}return{ok:l,synced:s}}static cycleOwnColor(){const e=t.localPlayer;if(!e)return;const r=(t.colorId(e)+1)%18;this.forceColor(e,r)}static murder(t,r){try{return t.method("MurderPlayer",2).invoke(r,1),!0}catch(t){return e.error(`[Troll.murder] ${t}`),!1}}static blameMurder(e,r){let o=0;const l=t.localPlayer;for(const s of r)l&&s.handle.equals(l.handle)||1===t.roleType(s)&&this.murder(s,e)&&o++;return o}static murderAsMe(e){const r=t.localPlayer;return!!r&&this.murder(r,e)}static murderCrew(e){const r=t.localPlayer;let o=0;for(const l of e)1!==t.roleType(l)&&(t.isDead(l)||r&&this.murder(r,l)&&o++);return o}static murderImpostors(e){const r=t.localPlayer;let o=0;for(const l of e)1===t.roleType(l)&&(r&&l.handle.equals(r.handle)||r&&this.murder(r,l)&&o++);return o}static spoofMessage(e,r){return t.sendChatAs(e,r)}static echoChamber(e,r){const o=r.filter((e=>{const r=t.localPlayer;return!r||!e.handle.equals(r.handle)}));if(0===o.length)return 0;const l=2+Math.floor(2*Math.random());let s=0;for(let r=0;r<l;r++){const r=o[Math.floor(Math.random()*o.length)];t.sendChatAs(r,e)&&s++}return s}static attached=[];static attach(t,e){this.attached.push({follower:t,leader:e})}static detachAll(){this.attached=[]}static tickAttachments(){for(const e of this.attached)try{t.snapToPlayer(e.follower,e.leader)}catch(t){}}}
