import{Game as t}from"../core/Game.js";import{State as e}from"../data/State.js";import{Logger as o}from"../utils/Logger.js";export const Sys={Reactor:3,Electrical:7,LifeSupp:8,Comms:14,Doors:16,Sabotage:17,Decontamination:18,MushroomMixupSabotage:57,HeliSabotage:58};export class Sabotage{static loopTimer=0;static hooked=!1;static init(){this.hooked||(this.hooked=!0,o.info("[Sabotage] ready"))}static rpc(e,s){const a=t.shipStatus;if(!a)return!1;try{return a.method("RpcUpdateSystem",2).invoke(e,s),!0}catch(t){return o.error(`[Sabotage.rpc] ${t}`),!1}}static sabotage(t){return this.rpc(Sys.Sabotage,t)}static lights(){return this.sabotage(Sys.Electrical)}static comms(){return this.sabotage(Sys.Comms)}static o2(){return this.sabotage(Sys.LifeSupp)}static reactor(){return this.sabotage(Sys.Reactor)}static mushrooms(){return this.sabotage(Sys.MushroomMixupSabotage)}static helicrash(){return this.sabotage(Sys.HeliSabotage)}static sabotageAll(){return[Sys.Electrical,Sys.Comms,Sys.LifeSupp,Sys.Reactor].filter((t=>this.sabotage(t))).length}static closeDoorsOf(e){const o=t.shipStatus;if(!o)return!1;try{return o.method("RpcCloseDoorsOfType",1).invoke(e),!0}catch(t){return this.rpc(Sys.Doors,128|31&e)}}static lockAllDoors(t=16){let e=0;for(let o=0;o<t;o++)this.closeDoorsOf(o)&&e++;return e}static repairAll(){const e=t.shipStatus;let o=0;try{e?.method("RepairCriticalSabotages").invoke(),o++}catch(t){}try{e?.method("RpcUpdateSystem",2).invoke(Sys.Electrical,16),o++}catch(t){}try{e?.method("RpcUpdateSystem",2).invoke(Sys.Comms,16),o++}catch(t){}return o}static tick(){if(!e.sabotageLoop)return;const t=Date.now();t-this.loopTimer<8e3||(this.loopTimer=t,this.sabotage(e.sabotageLoopSystem))}static rouletteRoll(){if(!e.sabotageRoulette)return;if(100*Math.random()>e.rouletteChance)return;const t=[Sys.Electrical,Sys.Comms];this.sabotage(t[Math.floor(Math.random()*t.length)]),o.info("[Sabotage] roulette triggered")}}
