{
  "compilerOptions": {
    "target": "esnext",
    "lib": [ "es2022" ],
    "types": ["node", "frida-gum"],
    "experimentalDecorators": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
